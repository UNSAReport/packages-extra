#let font-family = ("Times New Roman", "Liberation Serif")
#let font-size = 11pt
#let font-lang = "es"
#let font-hyphenate = false

#let page-paper = "a4"
#let cover-margin = (top: 2.5cm, bottom: 2.5cm, left: 2.5cm, right: 2.5cm)
#let body-margin = (top: 2.5cm, bottom: 2.5cm, left: 3.0cm, right: 2.5cm)
#let page-numbering = "1"
#let page-number-align = right

#let par-justify = true
#let par-first-line-indent = 0pt
#let par-spacing = 0.85em
#let par-leading = 0.65em
#let cover-par-leading = 1.0em

#let heading-font-size-l1 = 14pt
#let heading-font-size-l2 = 12pt
#let heading-font-size-l3 = 11.5pt
#let heading-font-size-l4 = 11pt
#let heading-font-size = 12pt
#let heading-weight = "bold"
#let heading-space-above = 1.25em
#let heading-space-below = 0.75em
#let title-text-size = 16pt
#let title-weight = "bold"
#let title-space-below = 1.2em

#let indent-width = 6pt
#let num-gutter = 0.6em

#let table-header-fill = rgb("f3f4f6")
#let table-cell-stroke = 0.5pt + luma(180)
#let table-text-size = 9pt
#let table-header-weight = "bold"

#let cover-logo-width = 4.2cm
#let cover-metadata-align = left
#let cover-metadata-left-inset = 0pt
#let cover-author-cui-gutter = 0.8cm
#let cover-motto-size = 13pt
#let cover-university-size = 15pt
#let cover-faculty-size = 13pt
#let cover-school-size = 13pt
#let cover-title-size = 16pt
#let cover-team-size = 14pt
#let cover-metadata-size = 11pt
#let cover-location-size = 12pt
#let cover-year-size = 12pt
